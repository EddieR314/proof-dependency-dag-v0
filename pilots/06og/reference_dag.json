  "facts": [
    {
      "id": "F1",
      "statement": "n>=2 and all a_i are positive.",
      "canonical_form": "PositiveFamily(a,n)",
      "introduction_kind": "given",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F1"
      ]
    },
    {
      "id": "F2",
      "statement": "S=sum a_i, E2=sum_{i<j} a_i a_j, and L is the left side.",
      "canonical_form": "SumDefinitions(S,E2,L)",
      "introduction_kind": "constructed",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F2"
      ]
    },
    {
      "id": "F3",
      "statement": "The target is equivalent to 2SL <= nE2 because 2S>0.",
      "canonical_form": "ScaledTargetEquivalent(S,L,n,E2)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F3"
      ]
    },
    {
      "id": "F4",
      "statement": "2SL equals 2E2 plus the residual sum collected by triples.",
      "canonical_form": "TripleExpansion(S,L,E2,T)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F4"
      ]
    },
    {
      "id": "F5",
      "statement": "For positive a,b,c, 1/a+1/b >= 4/(a+b).",
      "canonical_form": "PairReciprocalBound(a,b)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F5"
      ]
    },
    {
      "id": "F6",
      "statement": "For each positive triple, 2abc sum_cyc 1/(a+b) <= ab+bc+ca.",
      "canonical_form": "TripleReciprocalBound(a,b,c)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F6"
      ]
    },
    {
      "id": "F7",
      "statement": "Summing the local triple inequality bounds the residual triple sum.",
      "canonical_form": "SummedTripleBound(T,P)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F7"
      ]
    },
    {
      "id": "F8",
      "statement": "Every unordered pair occurs in exactly n-2 unordered triples.",
      "canonical_form": "PairTripleMultiplicity(n)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F8"
      ]
    },
    {
      "id": "F9",
      "statement": "The pair sum over all triples equals (n-2)E2.",
      "canonical_form": "TriplePairIdentity(P,n,E2)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
