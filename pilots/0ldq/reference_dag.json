  "facts": [
    {
      "id": "F1",
      "statement": "x_1=2 and x_{n+1}=sqrt(x_n+8)-sqrt(x_n+3).",
      "canonical_form": "Recurrence(x)",
      "introduction_kind": "given",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F1"
      ]
    },
    {
      "id": "F2",
      "statement": "All x_n are positive.",
      "canonical_form": "PositiveOrbit(x)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F2"
      ]
    },
    {
      "id": "F3",
      "statement": "F(x)=sqrt(x+8)-sqrt(x+3) and F(1)=1.",
      "canonical_form": "FixedPointMap(F)",
      "introduction_kind": "constructed",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F3"
      ]
    },
    {
      "id": "F4",
      "statement": "x_{n+1}-1=-rho(x_n)(x_n-1) with the stated rho.",
      "canonical_form": "SignedDeviationIdentity(x,rho)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F4"
      ]
    },
    {
      "id": "F5",
      "statement": "For x>=0, 0<rho(x)<1.",
      "canonical_form": "PointwiseContraction(rho)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F5"
      ]
    },
    {
      "id": "F6",
      "statement": "The deviations alternate sign and have nonincreasing magnitude.",
      "canonical_form": "AlternatingDeviations(x)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F6"
      ]
    },
    {
      "id": "F7",
      "statement": "The orbit remains in the compact interval [0,2].",
      "canonical_form": "InvariantCompactInterval(x)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F7"
      ]
    },
    {
      "id": "F8",
      "statement": "There is q<1 with rho(x)<=q throughout the orbit.",
      "canonical_form": "UniformContraction(rho,q)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F8"
      ]
    },
    {
      "id": "F9",
      "statement": "|x_n-1| <= q^(n-1), hence x_n tends to 1.",
      "canonical_form": "ConvergenceToOne(x)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F9"
      ]
    },
    {
      "id": "F10",
      "statement": "Every partial sum of d_i=x_i-1 lies in [0,1].",
      "canonical_form": "AlternatingPartialSumBound(x)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F10"
      ]
    },
    {
      "id": "F11",
      "statement": "n <= sum_{i=1}^n x_i <= n+1.",
      "canonical_form": "SequenceSumBound(x,n)",
      "introduction_kind": "derived",
      "roles": [
        "intermediate"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F11"
      ]
    },
    {
      "id": "F12",
      "statement": "The limit is 1 and the required sum bound holds for every n.",
      "canonical_form": "SequenceTarget(x,n)",
      "introduction_kind": "derived",
      "roles": [
        "goal"
      ],
      "scope": "global",
      "objects": [],
      "source_spans": [
        "reviewed-proof:F12"
      ]
    }
