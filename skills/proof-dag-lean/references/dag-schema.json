{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/proof-dag-schema-v0.4.json",
  "title": "Proof DAG Schema v0.4",
  "type": "object",
  "required": [
    "schema_version",
    "graph_kind",
    "graph_id",
    "problem_id",
    "target_fact_ids",
    "versions",
    "source_record",
    "scopes",
    "rule_schemas",
    "facts",
    "inferences",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "proof-dag-schema-v0.4"},
    "graph_kind": {"enum": ["reference", "candidate"]},
    "graph_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "target_fact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "versions": {"$ref": "#/$defs/versions"},
    "source_record": {"$ref": "#/$defs/sourceRecord"},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scope"}
    },
    "rule_schemas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ruleSchema"}
    },
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "inferences": {
      "type": "array",
      "items": {"$ref": "#/$defs/inference"}
    },
    "mutation": {"$ref": "#/$defs/mutation"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "versions": {
      "type": "object",
      "required": [
        "skill_standard",
        "dag_schema",
        "fact_schema",
        "inference_schema",
        "scope_schema",
        "mutation_schema",
        "canonicalizer",
        "rule_registry",
        "common_tooling",
        "domain_skill"
      ],
      "properties": {
        "skill_standard": {"const": "0.3"},
        "dag_schema": {"const": "proof-dag-schema-v0.4"},
        "fact_schema": {"type": "string", "minLength": 1},
        "inference_schema": {"type": "string", "minLength": 1},
        "scope_schema": {"type": "string", "minLength": 1},
        "mutation_schema": {"type": "string", "minLength": 1},
        "canonicalizer": {"type": "string", "minLength": 1},
        "rule_registry": {"type": "string", "minLength": 1},
        "common_tooling": {"type": "string", "minLength": 1},
        "domain_skill": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sourceRecord": {
      "type": "object",
      "required": [
        "problem_source",
        "solution_source",
        "source_hash",
        "candidate_reference_solution_hash"
      ],
      "properties": {
        "problem_source": {"type": "string", "minLength": 1},
        "solution_source": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string"},
        "source_hash": {"type": "string", "minLength": 1},
        "candidate_reference_solution_hash": {"type": "string", "minLength": 1},
        "reviewed_solution_hash": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["id", "parent_id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "kind": {"enum": ["global", "case", "contradiction", "lemma", "other"]}
      },
      "additionalProperties": false
    },
    "inputPattern": {
      "type": "object",
      "required": ["premise_role", "predicate"],
      "properties": {
        "premise_role": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "outputPattern": {
      "type": "object",
      "required": ["predicate"],
      "properties": {
        "predicate": {"type": "string", "minLength": 1},
        "canonical_form": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "ruleSchema": {
      "type": "object",
      "required": [
        "rule_id",
        "name",
        "category",
        "input_patterns",
        "variables",
        "variable_constraints",
        "output_pattern",
        "scope_constraints",
        "version"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "input_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inputPattern"}
        },
        "variables": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "variable_constraints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "output_pattern": {"$ref": "#/$defs/outputPattern"},
        "scope_constraints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "canonical_form",
        "introduction_kind",
        "roles",
        "scope",
        "objects",
        "source_spans"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^F[0-9A-Za-z_-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "canonical_form": {"type": "string", "minLength": 1},
        "introduction_kind": {
          "enum": ["given", "assumed", "case_assumed", "constructed", "derived"]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "goal",
              "intermediate",
              "case_condition",
              "contradiction",
              "lemma_output"
            ]
          },
          "uniqueItems": true
        },
        "scope": {"type": "string", "minLength": 1},
        "objects": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "source_spans": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "inputBinding": {
      "type": "object",
      "required": ["fact_id", "premise_role"],
      "properties": {
        "fact_id": {"type": "string"},
        "premise_role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "required": [
        "id",
        "spu_id",
        "source_order",
        "rule_id",
        "scope",
        "input_bindings",
        "variable_bindings",
        "output_fact_id",
        "source_spans",
        "risk_flags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^I[0-9A-Za-z_-]+$"},
        "spu_id": {"type": "string", "minLength": 1},
        "source_order": {"type": "integer", "minimum": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "input_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inputBinding"}
        },
        "variable_bindings": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "output_fact_id": {"type": "string"},
        "source_spans": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rule_application_group_id": {"type": "string"},
        "risk_flags": {
          "type": "array",
          "items": {
            "enum": [
              "hidden_domain_condition",
              "quantifier_sensitive",
              "scope_sensitive",
              "case_exhaustiveness",
              "existence_witness",
              "floor_or_ceiling",
              "wlog",
              "nonlinear_arithmetic",
              "large_lemma_compression",
              "geometric_diagram_dependency",
              "external_theorem_dependency"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["fact", "inference", "edge", "scope"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "breakSite": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["fact", "inference"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "required": [
        "base_graph_id",
        "operation",
        "primary_site",
        "injection_anchor",
        "declared_expected_first_break",
        "before",
        "after",
        "graph_changed",
        "target_effect",
        "provenance"
      ],
      "properties": {
        "base_graph_id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "primary_site": {"$ref": "#/$defs/site"},
        "injection_anchor": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["fact", "inference", "none"]},
            "id": {"type": "string"}
          },
          "additionalProperties": false
        },
        "declared_expected_first_break": {"$ref": "#/$defs/breakSite"},
        "before": {},
        "after": {},
        "graph_changed": {"const": true},
        "target_effect": {"enum": ["target_breaking", "target_preserving"]},
        "seed": {"type": "integer"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "current_annotation_level",
        "requested_target_level",
        "achieved_annotation_level",
        "promotion_profile"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "current_annotation_level": {
          "enum": ["raw", "synthetic", "silver_verified", "gold"]
        },
        "requested_target_level": {
          "enum": ["synthetic", "silver_verified", "gold"]
        },
        "achieved_annotation_level": {
          "enum": ["pending", "synthetic", "silver_verified", "gold"]
        },
        "promotion_profile": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
